@implements IDisposable

<div class="viewport-shell-box" style="width: 100%; height: 100%; max-height: 520px;">
    <div class="shell-label">RIGIDBODY_PROJECTILE.gd — BOUNCE COLLIDERS & LIVE KINEMATICS MATH</div>
    <div class="shell-content" style="height: 100%; padding: 32px 16px 12px 16px;">
        <div style="position: relative; width: 100%; height: 100%; background: #080c08; border: 1px solid #1a2a1a; overflow: hidden;">
            <svg width="100%" height="100%" viewBox="0 0 960 440" style="position: absolute; inset: 0;">
                <defs>
                    <pattern id="projGrid" width="32" height="32" patternUnits="userSpaceOnUse">
                        <path d="M 32 0 L 0 0 0 32" fill="none" stroke="#0e150e" stroke-width="0.8" />
                    </pattern>
                </defs>
                <rect width="960" height="440" fill="url(#projGrid)" />

                <!-- Floor and Walls -->
                <line x1="0" y1="410" x2="960" y2="410" stroke="#2a4a2a" stroke-width="2" />
                <rect x="910" y="80" width="20" height="330" fill="#142216" stroke="#2a4a2a" stroke-width="1.5" />

                <!-- Static Physics Obstacles -->
                <!-- 1. Central Pillar -->
                <rect x="480" y="240" width="40" height="170" fill="#152618" stroke="#3a6a3a" stroke-width="2" />
                <text x="500" y="320" fill="#4a6a48" font-family="'Share Tech Mono', monospace" font-size="9" text-anchor="middle">STATIC PILLAR</text>

                <!-- 2. Angled Deflector -->
                <polygon points="680,180 760,220 750,230 670,190" fill="#1f3622" stroke="#4ade80" stroke-width="1.5" />
                <text x="715" y="170" fill="#4ade80" font-family="'Share Tech Mono', monospace" font-size="8" text-anchor="middle">ANGLED DEFLECTOR</text>

                <!-- 3. Floating Bouncer Block -->
                <rect x="280" y="140" width="100" height="24" fill="#142416" stroke="#e5aa33" stroke-width="1.5" />
                <text x="330" y="156" fill="#e5aa33" font-family="'Share Tech Mono', monospace" font-size="8" text-anchor="middle">DEFLECTOR BARRIER</text>

                <!-- Active Projectiles with Kinematic Math Debug Tag -->
                @foreach (var p in projectiles)
                {
                    double speed = Math.Sqrt(p.Vx * p.Vx + p.Vy * p.Vy);
                    double angle = Math.Atan2(p.Vy, p.Vx) * (180.0 / Math.PI);

                    <circle cx="@p.X" cy="@p.Y" r="7" fill="#ffcb6b" stroke="#ff8c00" stroke-width="2" />
                    <!-- Velocity vector indicator -->
                    <line x1="@p.X" y1="@p.Y" x2="@(p.X + (p.Vx / speed) * 18)" y2="@(p.Y + (p.Vy / speed) * 18)" stroke="#4ade80" stroke-width="2" />

                    <!-- Live Kinematics Math Badge -->
                    <g transform="translate(@(p.X + 12), @(p.Y - 10))">
                        <rect x="-4" y="-12" width="118" height="26" fill="#090f0a" stroke="#2a4028" stroke-width="1" />
                        <text x="0" y="0" fill="#4ade80" font-family="'Share Tech Mono', monospace" font-size="7">
                            |V|: @(((int)speed)) px/s · θ: @(((int)angle))°
                        </text>
                        <text x="0" y="9" fill="#5a7a58" font-family="'Share Tech Mono', monospace" font-size="6.5">
                            Vx: @(((int)p.Vx)) | Vy: @(((int)p.Vy))
                        </text>
                    </g>
                }

                <!-- Cannon Origin -->
                <rect x="30" y="360" width="60" height="40" fill="#182c1a" stroke="#4ade80" stroke-width="2" />
                <line x1="70" y1="375" x2="115" y2="340" stroke="#4ade80" stroke-width="6" />
            </svg>

            <div style="position: absolute; bottom: 10px; left: 14px; font-family: 'Share Tech Mono', monospace; font-size: 0.58rem; color: #5a7a58;">
                ACTIVE: @projectiles.Count | PHYSICS: EULER INTEGRATION · GRAVITY = 980 px/s² · RESTITUTION = 0.55
            </div>
        </div>
    </div>
</div>

@code {
    public class Proj { public double X; public double Y; public double Vx; public double Vy; public double Life; }
    private readonly List<Proj> projectiles = new();
    private CancellationTokenSource cts = new();

    protected override void OnInitialized()
    {
        _ = RunPhysicsLoopAsync(cts.Token);
    }

    private async Task RunPhysicsLoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(16));
        DateTime last = DateTime.UtcNow;

        while (!token.IsCancellationRequested && await timer.WaitForNextTickAsync(token))
        {
            DateTime now = DateTime.UtcNow;
            double dt = Math.Min((now - last).TotalSeconds, 0.05);
            last = now;

            for (int i = projectiles.Count - 1; i >= 0; i--)
            {
                var p = projectiles[i];
                p.Life -= dt;
                p.Vy += 980.0 * dt; // Gravity
                p.X += p.Vx * dt;
                p.Y += p.Vy * dt;

                // 1. Floor collision
                if (p.Y >= 402) { p.Y = 402; p.Vy = -p.Vy * 0.55; p.Vx *= 0.85; }
                // 2. Right wall
                if (p.X >= 902) { p.X = 902; p.Vx = -p.Vx * 0.55; }
                // 3. Central Pillar collision (480 to 520, Y >= 240)
                if (p.X >= 472 && p.X <= 528 && p.Y >= 235)
                {
                    if (p.X < 480) { p.X = 472; p.Vx = -Math.Abs(p.Vx) * 0.6; }
                    else if (p.X > 520) { p.X = 528; p.Vx = Math.Abs(p.Vx) * 0.6; }
                    else if (p.Y <= 245) { p.Y = 235; p.Vy = -Math.Abs(p.Vy) * 0.6; }
                }
                // 4. Floating Barrier (280 to 380, Y 140 to 164)
                if (p.X >= 274 && p.X <= 386 && p.Y >= 134 && p.Y <= 170)
                {
                    p.Vy = -p.Vy * 0.7;
                }

                if (p.Life <= 0 || (Math.Abs(p.Vx) < 4 && p.Y >= 400))
                    projectiles.RemoveAt(i);
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    public void SpawnProjectile()
    {
        projectiles.Add(new Proj
        {
            X = 115,
            Y = 340,
            Vx = Random.Shared.Next(540, 720),
            Vy = Random.Shared.Next(-520, -360),
            Life = 4.5
        });
    }

    public void Reset() => projectiles.Clear();

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}