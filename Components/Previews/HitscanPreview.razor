@inject IJSRuntime JS

<div class="viewport-shell-box" style="width: 100%; height: 100%; max-height: 520px;">
    <div class="shell-label">HITSCAN_WEAPON.gd — ACCURATE MOUSE RAYCAST · TARGET RELOCATION</div>
    <div class="shell-content" style="height: 100%; padding: 32px 16px 12px 16px;">
        <div style="position: relative; width: 100%; height: 100%; background: #080c08; border: 1px solid #1a2a1a; overflow: hidden; cursor: crosshair;">
            
            <!-- SVG with an ID for precise element matrix mapping -->
            <svg id="hitscanSvgCanvas" 
                 width="100%" 
                 height="100%" 
                 viewBox="0 0 960 440" 
                 preserveAspectRatio="none"
                 style="position: absolute; inset: 0; width: 100%; height: 100%;"
                 @onmousedown="HandleSvgClick">
                <defs>
                    <pattern id="hitscanGrid" width="32" height="32" patternUnits="userSpaceOnUse">
                        <path d="M 32 0 L 0 0 0 32" fill="none" stroke="#0e150e" stroke-width="0.8" />
                    </pattern>
                </defs>
                <rect width="960" height="440" fill="url(#hitscanGrid)" />

                <!-- Targets -->
                @for (int i = 0; i < targets.Length; i++)
                {
                    int idx = i;
                    var t = targets[i];
                    <g transform="translate(@t.X, @t.Y)" style="transition: transform 0.2s ease-out; pointer-events: none;">
                        <circle cx="0" cy="0" r="30" fill="@(t.IsHit ? "#ff4444" : "#142216")" stroke="@(t.IsHit ? "#ff9999" : "#2a4a2a")" stroke-width="2" />
                        <circle cx="0" cy="0" r="16" fill="none" stroke="#3a6a3a" stroke-width="1.5" stroke-dasharray="3 3" />
                        <circle cx="0" cy="0" r="5" fill="#4ade80" />
                        <text x="0" y="44" fill="#4a6a48" font-family="'Share Tech Mono', monospace" font-size="10" text-anchor="middle">
                            TARGET @(idx + 1) [@(t.Hp) HP]
                        </text>
                    </g>
                }

                <!-- Explosion FX -->
                @if (exploding)
                {
                    <circle cx="@explX" cy="@explY" r="42" fill="none" stroke="#ffcb6b" stroke-width="3">
                        <animate attributeName="r" from="10" to="50" dur="0.25s" fill="freeze" />
                        <animate attributeName="opacity" from="1" to="0" dur="0.25s" fill="freeze" />
                    </circle>
                    <circle cx="@explX" cy="@explY" r="28" fill="rgba(255, 68, 68, 0.5)" />
                }

                <!-- Beam Line (Snaps cleanly to exact crosshair cursor tip) -->
                @if (isFiring)
                {
                    <line x1="80" y1="360" x2="@clickX" y2="@clickY" stroke="#4ade80" stroke-width="3" />
                    <line x1="80" y1="360" x2="@clickX" y2="@clickY" stroke="#ffffff" stroke-width="1.5" />
                    <circle cx="@clickX" cy="@clickY" r="8" fill="rgba(74, 222, 128, 0.6)" stroke="#4ade80" />
                }

                <!-- Muzzle -->
                <g style="pointer-events: none;">
                    <circle cx="80" cy="360" r="18" fill="#1b2e1e" stroke="#4ade80" stroke-width="2" />
                    <line x1="80" y1="360" x2="105" y2="335" stroke="#4ade80" stroke-width="4" />
                    <text x="80" y="396" fill="#4a6a48" font-family="'Share Tech Mono', monospace" font-size="10" text-anchor="middle">MUZZLE</text>
                </g>
            </svg>

            <div style="position: absolute; bottom: 10px; left: 14px; font-family: 'Share Tech Mono', monospace; font-size: 0.58rem; color: #5a7a58; pointer-events: none;">
                RAYCAST LOG: @logMessage
            </div>
        </div>
    </div>
</div>

@code {
    public class TargetData { public double X; public double Y; public int Hp; public bool IsHit; }
    private TargetData[] targets = new TargetData[]
    {
        new() { X = 320, Y = 120, Hp = 100 },
        new() { X = 620, Y = 160, Hp = 100 },
        new() { X = 820, Y = 280, Hp = 100 }
    };

    private bool isFiring = false;
    private double clickX = 0;
    private double clickY = 0;
    private bool exploding = false;
    private double explX = 0;
    private double explY = 0;
    private string logMessage = "CLICK ANYWHERE ON THE STAGE TO FIRE RAYCAST.";

    private async Task HandleSvgClick(MouseEventArgs e)
    {
        // Query the SVG's actual rendered pixel width and height on screen
        var bounds = await JS.InvokeAsync<BoundingRect>("eval", 
            "(() => { const el = document.getElementById('hitscanSvgCanvas'); if (!el) return { width: 960, height: 440, left: 0, top: 0 }; const r = el.getBoundingClientRect(); return { width: r.width, height: r.height, left: r.left, top: r.top }; })()");

        // Normalize client coordinates to the 960x440 viewBox
        double scaleX = 960.0 / (bounds.Width > 0 ? bounds.Width : 960.0);
        double scaleY = 440.0 / (bounds.Height > 0 ? bounds.Height : 440.0);

        clickX = Math.Clamp((e.ClientX - bounds.Left) * scaleX, 10, 950);
        clickY = Math.Clamp((e.ClientY - bounds.Top) * scaleY, 10, 430);

        isFiring = true;
        logMessage = $"RAYCAST FIRED TO ({((int)clickX)}, {((int)clickY)})";

        // Check if click coordinates hit any target's 30px collision radius
        bool hitAny = false;
        for (int i = 0; i < targets.Length; i++)
        {
            var t = targets[i];
            double dist = Math.Sqrt(Math.Pow(clickX - t.X, 2) + Math.Pow(clickY - t.Y, 2));
            if (dist <= 35)
            {
                hitAny = true;
                t.Hp -= 35;
                t.IsHit = true;

                if (t.Hp <= 0)
                {
                    explX = t.X;
                    explY = t.Y;
                    exploding = true;
                    logMessage = $"TARGET_{i + 1} DESTROYED! EXPLODING & RESPAWNING AT NEW POSITION";
                    t.X = Random.Shared.Next(240, 880);
                    t.Y = Random.Shared.Next(80, 360);
                    t.Hp = 100;
                }
                else
                {
                    logMessage = $"TARGET_{i + 1} HIT! RELOCATING (-35 HP, {t.Hp} REMAINING)";
                    t.X = Random.Shared.Next(240, 880);
                    t.Y = Random.Shared.Next(80, 360);
                }
                break;
            }
        }

        if (!hitAny)
        {
            logMessage = $"RAYCAST MISSED TARGETS — IMPACTED GEOMETRY AT ({((int)clickX)}, {((int)clickY)})";
        }

        StateHasChanged();
        await Task.Delay(140);
        isFiring = false;
        foreach (var t in targets) t.IsHit = false;
        exploding = false;
        StateHasChanged();
    }

    public void FireAt(int idx)
    {
        if (idx >= 0 && idx < targets.Length)
        {
            var t = targets[idx];
            clickX = t.X;
            clickY = t.Y;
            isFiring = true;
            t.Hp -= 35;
            t.IsHit = true;
            if (t.Hp <= 0)
            {
                explX = t.X; explY = t.Y; exploding = true;
                t.X = Random.Shared.Next(240, 880); t.Y = Random.Shared.Next(80, 360); t.Hp = 100;
            }
            else
            {
                t.X = Random.Shared.Next(240, 880); t.Y = Random.Shared.Next(80, 360);
            }
            logMessage = $"BUTTON OVERRIDE: DIRECT HIT ON TARGET_{idx + 1}";
            StateHasChanged();
            Task.Delay(140).ContinueWith(_ => { isFiring = false; foreach (var tg in targets) tg.IsHit = false; exploding = false; InvokeAsync(StateHasChanged); });
        }
    }

    public void AutoFire() => FireAt(Random.Shared.Next(0, targets.Length));

    public void Reset()
    {
        targets = new TargetData[]
        {
            new() { X = 320, Y = 120, Hp = 100 },
            new() { X = 620, Y = 160, Hp = 100 },
            new() { X = 820, Y = 280, Hp = 100 }
        };
        lastHitTarget = -1;
        isFiring = false;
        logMessage = "TARGETS RESET TO 100 HP.";
    }

    private int lastHitTarget = -1;

    public class BoundingRect
    {
        public double Width { get; set; }
        public double Height { get; set; }
        public double Left { get; set; }
        public double Top { get; set; }
    }
}