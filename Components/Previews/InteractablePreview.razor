<div class="viewport-shell-box" style="width: 100%; height: 100%; max-height: 520px;">
    <div class="shell-label">INTERACTABLE_OBJECT.gd — KEYBOARD [A/D MOVE · E INTERACT]</div>
    <div class="shell-content" style="height: 100%; padding: 32px 16px 12px 16px;">
        <div style="position: relative; width: 100%; height: 100%; background: #080c08; border: 1px solid #1a2a1a; overflow: hidden;">
            <svg width="100%" height="100%" viewBox="0 0 960 440" style="position: absolute; inset: 0;">
                <defs>
                    <pattern id="interGrid" width="32" height="32" patternUnits="userSpaceOnUse">
                        <path d="M 32 0 L 0 0 0 32" fill="none" stroke="#0e150e" stroke-width="0.8" />
                    </pattern>
                </defs>
                <rect width="960" height="440" fill="url(#interGrid)" />

                <!-- Floor -->
                <line x1="0" y1="360" x2="960" y2="360" stroke="#1f3422" stroke-width="2" />

                <!-- Proximity Detection Area Sphere -->
                <circle cx="640" cy="300" r="160" fill="rgba(74, 222, 128, 0.05)" stroke="#2a4a2a" stroke-width="1.5" stroke-dasharray="4 4" />

                <!-- Terminal Object -->
                <g transform="translate(640, 260)">
                    <rect x="-35" y="0" width="70" height="100" fill="#142216" stroke="#4ade80" stroke-width="2" />
                    <rect x="-22" y="16" width="44" height="32" fill="@(isOpen ? "#2a9a44" : "#0d160e")" stroke="#3a6a3a" />
                    <text x="0" y="120" fill="#4a6a48" font-family="'Share Tech Mono', monospace" font-size="11" text-anchor="middle">
                        TERMINAL_01
                    </text>
                </g>

                <!-- 3D Billboard Prompt Label -->
                @if (IsWithinRadius)
                {
                    <g transform="translate(640, 215)">
                        <rect x="-64" y="-16" width="128" height="26" fill="#0c140d" stroke="#4ade80" stroke-width="1.5" />
                        <text x="0" y="0" fill="#4ade80" font-family="'Share Tech Mono', monospace" font-size="11" text-anchor="middle" dominant-baseline="middle">
                            [ E ] INTERACT
                        </text>
                    </g>
                }

                <!-- Player Character -->
                <g transform="translate(@PlayerX, 280)">
                    <rect x="-18" y="0" width="36" height="80" fill="#1b2e1e" stroke="#4ade80" stroke-width="2" />
                    <rect x="-8" y="14" width="16" height="22" fill="#2a4a2a" />
                    <text x="0" y="-12" fill="#4ade80" font-family="'Share Tech Mono', monospace" font-size="11" text-anchor="middle">
                        PLAYER
                    </text>
                </g>
            </svg>

            <!-- Interaction Dialog Box -->
            @if (isOpen)
            {
                <div style="position: absolute; top: 24px; left: 50%; transform: translateX(-50%); background: #0c140e; border: 1.5px solid #4ade80; padding: 14px 28px; font-family: 'Share Tech Mono', monospace; font-size: 0.85rem; color: #4ade80; box-shadow: 0 6px 24px rgba(0,0,0,0.85); z-index: 10;">
                    ACCESS GRANTED: LEVEL_02 SYSTEM OVERRIDE ACTIVE
                </div>
            }

            <div style="position: absolute; bottom: 10px; left: 14px; font-family: 'Share Tech Mono', monospace; font-size: 0.58rem; color: #5a7a58;">
                DISTANCE: @((int)Math.Abs(640 - PlayerX))px | PROXIMITY MASK: @(IsWithinRadius ? "INSIDE TRIGGER [PRESS E]" : "OUT OF RANGE")
            </div>
        </div>
    </div>
</div>

@code {
    public double PlayerX { get; set; } = 240;
    public bool isOpen = false;
    public bool IsWithinRadius => Math.Abs(640 - PlayerX) <= 160;

    public void MoveLeft()
    {
        PlayerX = Math.Max(80, PlayerX - 40);
        isOpen = false;
        StateHasChanged();
    }

    public void MoveRight()
    {
        PlayerX = Math.Min(880, PlayerX + 40);
        isOpen = false;
        StateHasChanged();
    }

    public void Interact()
    {
        if (IsWithinRadius)
        {
            isOpen = !isOpen;
            StateHasChanged();
        }
    }

    public void Reset()
    {
        PlayerX = 240;
        isOpen = false;
        StateHasChanged();
    }
}