@implements IDisposable

<div class="viewport-shell-box">
    <div class="shell-label">PLATFORMER_CONTROLLER_2D.gd — PURE C# ENGINE</div>
    <div class="shell-content">
        <div style="position: relative; width: 560px; height: 270px; background: #0a0e0a; border: 1px solid #1a2a1a; overflow: hidden; image-rendering: pixelated;">
            <!-- Platforms -->
            @foreach (var p in platforms)
            {
                <div style="position: absolute; left: @(p.X)px; top: @(p.Y)px; width: @(p.W)px; height: @(p.H)px; background: #1a2a1a;">
                    <div style="width: 100%; height: 2px; background: #2a4a2a;"></div>
                </div>
            }

            <!-- Coyote indicator -->
            @if (coyote > 0 && !onFloor)
            {
                <div style="position: absolute; left: @(x - 14)px; top: @(y + 17)px; width: 28px; height: 3px; background: rgba(255,200,0,@((coyote / 0.12f * 0.5f).ToString("F2", System.Globalization.CultureInfo.InvariantCulture)));"></div>
            }

            <!-- Player Box -->
            @{
                string bc = onFloor ? "#4ade80" : "#82aaff";
                double bob = onFloor && vx != 0 ? Math.Sin(walkFrame * Math.PI / 2.0) * 2.0 : 0.0;
                double eyeX = facing > 0 ? (x + 2) : (x - 6);
                string stLbl = !onFloor ? (vy < 0 ? "JUMP" : "FALL") : (vx != 0 ? "WALK" : "IDLE");
            }

            <!-- Outer Body -->
            <div style="position: absolute; left: @(x - 10)px; top: @(y - 16 + bob)px; width: 20px; height: 32px; background: #0d0f0d;"></div>
            <!-- Inner Color Body -->
            <div style="position: absolute; left: @(x - 8)px; top: @(y - 14 + bob)px; width: 16px; height: 28px; background: @bc;"></div>
            <!-- Eye -->
            <div style="position: absolute; left: @(eyeX)px; top: @(y - 10 + bob)px; width: 5px; height: 4px; background: #0d0f0d;"></div>

            <!-- State Label -->
            <div style="position: absolute; left: @(x - 10)px; top: @(y - 22 + bob)px; font-family: 'Share Tech Mono', monospace; font-size: 7px; color: #3a5a38;">
                @stLbl
            </div>

            <!-- Jump Buffer Bar -->
            @if (jumpBuf > 0)
            {
                <div style="position: absolute; left: @(x - 10)px; top: @(y + 18 + bob)px; height: 3px; width: @(20.0 * (jumpBuf / 0.1f))px; background: rgba(130,170,255,0.5);"></div>
            }
        </div>
    </div>
</div>

@code {
    private record Platform(double X, double Y, double W, double H);
    private readonly List<Platform> platforms = new()
    {
        new(0, 180, 160, 10),
        new(180, 150, 110, 10),
        new(310, 120, 90, 10),
        new(420, 160, 80, 10),
        new(0, 240, 560, 30)
    };

    private double x = 80;
    private double y = 120;
    private double vx = 0;
    private double vy = 0;
    private bool onFloor = false;
    private float coyote = 0;
    private float jumpBuf = 0;
    private int facing = 1;
    private int walkFrame = 0;
    private double frameTimer = 0;

    private const double GRAVITY = 1100;
    private const double SPEED = 180;
    private const double JUMP = -420;
    private const float COYOTE_TIME = 0.12f;
    private const float JBUF_TIME = 0.1f;

    public bool KeyLeft { get; set; }
    public bool KeyRight { get; set; }

    private CancellationTokenSource cts = new();

    protected override void OnInitialized()
    {
        _ = RunPhysicsLoopAsync(cts.Token);
    }

    private async Task RunPhysicsLoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(16));
        DateTime lastTime = DateTime.UtcNow;

        while (!token.IsCancellationRequested && await timer.WaitForNextTickAsync(token))
        {
            DateTime now = DateTime.UtcNow;
            double dt = Math.Min((now - lastTime).TotalSeconds, 0.05);
            lastTime = now;

            vy += GRAVITY * dt;

            if (KeyLeft) { vx = -SPEED; facing = -1; }
            else if (KeyRight) { vx = SPEED; facing = 1; }
            else { vx = 0; }

            coyote = onFloor ? 0 : Math.Max(0, coyote - (float)dt);
            jumpBuf = Math.Max(0, jumpBuf - (float)dt);

            if (jumpBuf > 0 && (onFloor || coyote > 0))
            {
                vy = JUMP;
                jumpBuf = 0;
                coyote = 0;
            }

            bool prevFloor = onFloor;
            onFloor = false;
            x += vx * dt;
            y += vy * dt;

            foreach (var p in platforms)
            {
                if (x + 10 > p.X && x - 10 < p.X + p.W && y + 16 > p.Y && y + 16 < p.Y + p.H + 10 && vy >= 0)
                {
                    y = p.Y - 16;
                    vy = 0;
                    onFloor = true;
                }
            }

            if (!prevFloor && onFloor) coyote = 0;
            if (prevFloor && !onFloor) coyote = COYOTE_TIME;

            if (onFloor && Math.Abs(vx) > 0)
            {
                frameTimer += dt;
                if (frameTimer > 0.1)
                {
                    walkFrame = (walkFrame + 1) % 4;
                    frameTimer = 0;
                }
            }

            if (x > 570) x = -10;
            if (x < -10) x = 570;

            await InvokeAsync(StateHasChanged);
        }
    }

    public void MoveLeft(bool down) => KeyLeft = down;
    public void MoveRight(bool down) => KeyRight = down;
    public void TriggerJump() => jumpBuf = JBUF_TIME;
    public void Reset() { x = 80; y = 120; vx = 0; vy = 0; }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}