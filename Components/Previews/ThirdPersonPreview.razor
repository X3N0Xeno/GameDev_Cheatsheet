@implements IDisposable

<div class="viewport-shell-box" style="width: 100%; height: 100%; max-height: 520px;">
    <div class="shell-label">THIRD_PERSON_CONTROLLER_3D.gd — FULL CAMERA LOOK & ORBIT SYSTEM</div>
    <div class="shell-content" style="height: 100%; padding: 32px 16px 12px 16px;">
        <div @onmousemove="HandleMouseMove"
             style="position: relative; width: 100%; height: 100%; background: #080c08; border: 1px solid #1a2a1a; overflow: hidden; user-select: none;">
            
            @if (IsOverShoulderPov)
            {
                <!-- ── MODE A: CONTROLLABLE OVER-THE-SHOULDER POV ── -->
                <div style="width: 100%; height: 100%; position: relative; cursor: crosshair;">
                    <!-- Rotating Sky Horizon based on CamYaw -->
                    <div style="position: absolute; inset: 0; background: linear-gradient(180deg, #060c18 0%, #0c182c 50%, #0a140c 50%, #050a06 100%); transform: translateY(@(CamPitch * 0.8)px);"></div>
                    
                    <!-- Perspective Ground Lines rotating with CamYaw -->
                    <svg width="100%" height="100%" style="position: absolute; inset: 0; transform: translateY(@(CamPitch * 0.8)px);">
                        @for (int i = -8; i <= 8; i++)
                        {
                            double startX = 480 + (i * 30) + (CamYaw * 1.5);
                            double endX = 480 + (i * 200) + (CamYaw * 4.0);
                            <line x1="@startX" y1="240" x2="@endX" y2="520" stroke="#142616" stroke-width="1.5" />
                        }
                    </svg>

                    <!-- Distant World Pillars tracking with camera angle -->
                    @foreach (var ox in new int[] { -280, 0, 280 })
                    {
                        double px = 480 + ox + (CamYaw * 2.2);
                        <div style="position: absolute; width: 50px; height: 120px; background: #121c14; border: 1px solid #233827; 
                                    left: @(px)px; top: calc(50% - 60px + @(CamPitch * 0.8)px); transform: translateX(-50%);">
                            <div style="width: 100%; height: 3px; background: #4ade80; opacity: 0.6;"></div>
                        </div>
                    }

                    <!-- Player Shoulder (Moves with character movement & camera sway) -->
                    <div style="position: absolute; bottom: 0; left: calc(32% - @(CamYaw * 0.4)px); width: 140px; height: 180px; pointer-events: none; transition: left 0.05s ease-out;">
                        <div style="position: absolute; bottom: 0; left: 20px; width: 100px; height: 120px; background: #16281a; border: 2px solid #2ee586; border-radius: 8px 8px 0 0;"></div>
                        <div style="position: absolute; top: 18px; left: 45px; width: 50px; height: 50px; background: #111d13; border: 2px solid #4ade80; border-radius: 6px;"></div>
                    </div>

                    <!-- Target Reticle in POV Mode -->
                    <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 22px; height: 22px; pointer-events: none;">
                        <circle cx="11" cy="11" r="8" stroke="#4ade80" stroke-width="1.5" fill="none" />
                        <circle cx="11" cy="11" r="2" fill="#4ade80" />
                    </div>

                    <div style="position: absolute; top: 12px; left: 14px; font-family: 'Share Tech Mono', monospace; font-size: 0.58rem; color: #4ade80;">
                        DRAG MOUSE OR USE [Q/E] TO ROTATE CAMERA POV
                    </div>
                </div>
            }
            else
            {
                <!-- ── MODE B: ORBIT OVERVIEW (EXPANDED TO FULL VIEWPORT) ── -->
                <svg width="100%" height="100%" viewBox="0 0 960 460" style="position: absolute; inset: 0;">
                    <defs>
                        <pattern id="tpGridWide" width="32" height="32" patternUnits="userSpaceOnUse">
                            <path d="M 32 0 L 0 0 0 32" fill="none" stroke="#0e150e" stroke-width="0.8" />
                        </pattern>
                    </defs>
                    <rect width="960" height="460" fill="url(#tpGridWide)" />

                    <!-- Obstacle Pillars -->
                    <rect x="680" y="100" width="80" height="120" fill="#121812" stroke="#223625" stroke-width="2" />
                    <text x="720" y="165" fill="#3a5a3c" font-family="'Share Tech Mono', monospace" font-size="10" text-anchor="middle">STATIC MESH</text>

                    <rect x="180" y="220" width="90" height="90" fill="#121812" stroke="#223625" stroke-width="2" />
                    <text x="225" y="270" fill="#3a5a3c" font-family="'Share Tech Mono', monospace" font-size="10" text-anchor="middle">OBSTACLE</text>

                    <!-- SpringArm3D Raycast Vector -->
                    <line x1="@PlayerX" y1="@PlayerY" x2="@camX" y2="@camY" stroke="#2a6a2a" stroke-width="2.5" stroke-dasharray="6 4" />
                    
                    <!-- Camera Frustum Projection Cone -->
                    <polygon points="@camX,@camY @(PlayerX - 44),@(PlayerY - 20) @(PlayerX + 44),@(PlayerY + 20)" fill="rgba(74, 222, 128, 0.08)" />

                    <!-- Player Root with Dynamic Facing Rotation Angle -->
                    <g transform="translate(@PlayerX, @PlayerY) rotate(@PlayerFacingDeg)">
                        <circle cx="0" cy="0" r="22" fill="none" stroke="#223a24" stroke-width="1.5" stroke-dasharray="3 3" />
                        <rect x="-14" y="-18" width="28" height="36" fill="#4ade80" stroke="#0d0f0d" stroke-width="2" />
                        <polygon points="0,-28 -10,-10 10,-10" fill="#7fffa0" />
                    </g>

                    <!-- Orbiting Camera Node -->
                    <g transform="translate(@camX, @camY)">
                        <rect x="-14" y="-10" width="28" height="20" fill="#142850" stroke="#2a68c0" stroke-width="2" />
                        <circle cx="0" cy="0" r="5" fill="#60a5fa" />
                    </g>

                    <!-- Spatial Node Labels -->
                    <text x="@(PlayerX + 24)" y="@(PlayerY - 18)" fill="#4ade80" font-size="11" font-family="'Share Tech Mono', monospace" font-weight="bold">PLAYER [ROOT]</text>
                    <text x="@(camX + 18)" y="@(camY - 10)" fill="#60a5fa" font-size="11" font-family="'Share Tech Mono', monospace" font-weight="bold">CAMERA3D</text>
                    <text x="@((PlayerX + camX)/2 + 8)" y="@((PlayerY + camY)/2 - 8)" fill="#4a6a48" font-size="9" font-family="'Share Tech Mono', monospace">
                        SpringArm3D [@((EffectiveDistance / 25.0).ToString("0.0"))m]
                    </text>
                </svg>
            }

            <!-- POV TOGGLE BUTTON -->
            <button @onclick="() => IsOverShoulderPov = !IsOverShoulderPov"
                    style="position: absolute; top: 12px; right: 14px; background: #141c14; border: 1px solid #2a4028; color: #4ade80; font-family: 'Share Tech Mono', monospace; font-size: 0.65rem; padding: 6px 12px; cursor: pointer; z-index: 20;">
                @(IsOverShoulderPov ? "SWITCH TO ORBIT VIEW" : "SWITCH TO CAMERA POV")
            </button>

            <!-- Diagnostics Bar -->
            <div style="position: absolute; bottom: 10px; left: 14px; font-family: 'Share Tech Mono', monospace; font-size: 0.58rem; color: #4a6a48; z-index: 10;">
                ORBIT_ANGLE: @((int)CamOrbitAngle)° | FACING: @((int)PlayerFacingDeg)° | POS: @((int)PlayerX), @((int)PlayerY)
            </div>
        </div>
    </div>
</div>

@code {
    public double PlayerX { get; set; } = 420;
    public double PlayerY { get; set; } = 220;
    public double CamOrbitAngle { get; set; } = 35;
    public double CamYaw { get; set; } = 0;
    public double CamPitch { get; set; } = 0;
    public double PlayerFacingDeg { get; set; } = 0;
    public double SpringLen { get; set; } = 150;
    public bool IsOverShoulderPov { get; set; } = false;

    public bool KeyW { get; set; }
    public bool KeyS { get; set; }
    public bool KeyA { get; set; }
    public bool KeyD { get; set; }

    private CancellationTokenSource cts = new();

    protected override void OnInitialized()
    {
        _ = RunThirdPersonLoopAsync(cts.Token);
    }

    private async Task RunThirdPersonLoopAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(16));

        while (!token.IsCancellationRequested && await timer.WaitForNextTickAsync(token))
        {
            double dx = 0, dy = 0;
            if (KeyW) dy -= 2.6;
            if (KeyS) dy += 2.6;
            if (KeyA) dx -= 2.6;
            if (KeyD) dx += 2.6;

            if (dx != 0 || dy != 0)
            {
                PlayerX = Math.Clamp(PlayerX + dx, 60, 900);
                PlayerY = Math.Clamp(PlayerY + dy, 60, 400);
                PlayerFacingDeg = Math.Atan2(dy, dx) * (180.0 / Math.PI) + 90;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        if (e.Buttons == 1) // Dragging in viewport
        {
            if (IsOverShoulderPov)
            {
                CamYaw += e.MovementX * 0.4;
                CamPitch = Math.Clamp(CamPitch + e.MovementY * 0.4, -40, 40);
            }
            else
            {
                CamOrbitAngle = (CamOrbitAngle + e.MovementX * 0.5) % 360;
            }
        }
    }

    private double EffectiveDistance
    {
        get
        {
            double rad = (CamOrbitAngle * Math.PI) / 180.0;
            double testX = PlayerX + Math.Cos(rad) * SpringLen;
            double testY = PlayerY + Math.Sin(rad) * SpringLen * 0.6;
            if (testX > 660 && testX < 780 && testY > 80 && testY < 230) return SpringLen * 0.55;
            return SpringLen;
        }
    }

    private double camX => PlayerX + Math.Cos((CamOrbitAngle * Math.PI) / 180.0) * EffectiveDistance;
    private double camY => PlayerY + Math.Sin((CamOrbitAngle * Math.PI) / 180.0) * EffectiveDistance * 0.6;

    public void Orbit(double delta)
    {
        CamOrbitAngle = (CamOrbitAngle + delta) % 360;
        CamYaw += delta;
    }

    public void Reset()
    {
        PlayerX = 420; PlayerY = 220; CamOrbitAngle = 35; CamYaw = 0; CamPitch = 0; PlayerFacingDeg = 0;
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}