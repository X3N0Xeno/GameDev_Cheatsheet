@page "/"
@using GameDevCheatsheet.Models
@using GameDevCheatsheet.Data
@using GameDevCheatsheet.Components.Previews
@inject IJSRuntime JS

<div class="flex flex-col h-screen outline-none bg-terminal-0 text-[#d6e1da] font-mono select-none" 
     tabindex="0" 
     @onkeydown="HandleGlobalKeydown" 
     @onkeyup="HandleGlobalKeyup" 
     autofocus>

    <!-- TOP STATUS & ROUTE BAR -->
    <header class="flex-none h-[46px] flex items-center justify-between px-5 text-xs bg-gradient-to-b from-white/[0.025] to-transparent border-b border-line">
        <div class="flex items-center gap-3 min-w-0">
            <!-- Terminal Dots -->
            <div class="flex items-center gap-2 mr-3 opacity-80">
                <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f57] inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#febc2e] inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#28c840] inline-block"></span>
            </div>

            <span class="text-accent font-semibold tracking-wide whitespace-nowrap pl-3 border-l border-line-2 leading-5">
                GameDev Component Cheatsheet
            </span>
            <span class="text-[#6a7e73] whitespace-nowrap overflow-hidden text-ellipsis">
                — @selectedComponent.SubRoute
            </span>
        </div>

        <!-- Page Navigation Links -->
        <nav class="flex items-center gap-2 text-[11px]">
            <a href="/" class="px-3 py-1 rounded-md bg-accent-bg text-accent border border-accent-line font-semibold transition-colors">
                [CHEATSHEET]
            </a>
            <a href="/architecture" class="px-3 py-1 rounded-md text-[#9db0a5] hover:text-white hover:bg-white/5 border border-transparent transition-colors">
                [ARCHITECTURE]
            </a>
            <a href="/sandbox" class="px-3 py-1 rounded-md text-[#9db0a5] hover:text-white hover:bg-white/5 border border-transparent transition-colors">
                [SANDBOX]
            </a>
            <div class="hidden md:inline-flex items-center gap-2 pl-3 ml-2 border-l border-line-2 text-[#6a7e73] text-[10.5px] tracking-wider">
                <span class="w-1.5 h-1.5 rounded-full bg-accent animate-pulse shadow-[0_0_8px_#2ee586]"></span>
                GODOT 4.x SDK REV_B
            </div>
        </nav>
    </header>

    <!-- 3-COLUMN MAIN LAYOUT -->
    <div class="flex-1 min-h-0 grid grid-cols-[256px_minmax(0,1fr)_372px] gap-2.5 p-2.5 pb-1">
        
        <!-- 1. LEFT SIDEBAR -->
        <aside class="bg-terminal-1 border border-line rounded-[14px] shadow-[inset_0_1px_0_rgba(255,255,255,0.025),0_14px_36px_rgba(0,0,0,0.35)] overflow-y-auto flex flex-col">
            <div class="sticky top-0 z-10 h-[42px] flex items-center justify-between px-4 text-[10.5px] font-semibold tracking-widest bg-terminal-1/90 backdrop-blur border-b border-line text-accent">
                <span>COMPONENT LIBRARY</span>
                <span class="text-[#6a7e73] font-normal font-sans">⚙</span>
            </div>

            <div class="flex-1 overflow-y-auto">
                @foreach (var category in categories)
                {
                    <div class="border-b border-line last:border-b-0">
                        <div class="p-3 px-4 text-[10.5px] tracking-wider text-[#9db0a5] flex items-center justify-between gap-2 font-semibold cursor-pointer hover:bg-white/[0.025] hover:text-white transition-colors"
                             @onclick="() => category.IsExpanded = !category.IsExpanded">
                            <span>@category.Icon @category.Name</span>
                            <span class="text-xs transition-transform duration-200 @(category.IsExpanded ? "rotate-90 text-accent" : "text-[#465850]")">›</span>
                        </div>
                        @if (category.IsExpanded)
                        {
                            <div class="flex flex-col gap-0.5 px-2 pb-3">
                                @foreach (var item in category.Items)
                                {
                                    <div class="relative px-3 py-2 text-xs rounded-lg cursor-pointer transition-all @(selectedComponent.Id == item.Id ? "bg-gradient-to-r from-accent-bg-2 to-accent/5 text-accent font-semibold shadow-[inset_0_0_0_1px_rgba(46,229,134,0.22)]" : "text-[#9db0a5] hover:bg-white/[0.035] hover:text-white")"
                                         @onclick="() => SelectComponent(item)">
                                        <span class="mr-1 opacity-50">›</span>
                                        @item.Title
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </aside>

        <!-- 2. CENTER VIEWPORT -->
        <main class="relative bg-terminal-1 border border-line rounded-[14px] shadow-[inset_0_1px_0_rgba(255,255,255,0.025),0_14px_36px_rgba(0,0,0,0.35)] flex flex-col items-center justify-center p-7 pt-14 pb-5 overflow-hidden">
            <div class="absolute top-0 inset-x-0 h-[42px] flex items-center justify-between px-4 text-[10.5px] font-semibold tracking-widest bg-terminal-1/80 backdrop-blur border-b border-line z-10">
                <span class="text-accent">VIEWPORT <span class="text-[#465850] font-normal">— @selectedComponent.SubRoute</span></span>
                <span class="text-[#6a7e73] font-normal">1:1 FIT</span>
            </div>

            <div class="relative z-[1] flex flex-col w-full max-w-[1020px] h-full items-center justify-center">
                @switch (selectedComponent.Id)
                {
                    /* UI/UX */
                    case "linear-bar":
                        <LinearBarPreview DisplayHealth="@displayHealth" DisplayGhost="@displayGhost" 
                                          MaxHealth="@maxHealth" EnableGhost="@enableGhost" />
                        break;
                    case "heart-system":
                        <HeartPreview HeartPoints="@heartPoints" MaxHearts="@maxHearts" />
                        break;
                    case "overhead-bar":
                        <OverheadPreview OverheadHealth="@overheadHealth" />
                        break;
                    case "shield-layer":
                        <ShieldPreview DisplayShield="@displayShield" DisplayHealth="@displayShieldHealth" 
                                       IsBroken="@isShieldBroken" CooldownMs="@shieldCooldown" />
                        break;

                    /* MENUS */
                    case "main-menu":
                        <MainMenuPreview SelectedMenuIndex="@mainMenuIdx" ActionStatus="@menuStatus"
                                         OnSelectOption="OnMainMenuOptionClicked" />
                        break;
                    case "pause-menu":
                        <PauseMenuPreview IsPaused="@isGamePaused" 
                                          OnResume="() => isGamePaused = false" 
                                          OnRestart="() => isGamePaused = true" 
                                          OnQuit="() => isGamePaused = false" />
                        break;
                    case "audio-settings":
                        <AudioMixerPreview MasterVolume="@masterVol" MusicVolume="@musicVol" SfxVolume="@sfxVol"
                                           MasterMuted="@masterMute" MusicMuted="@musicMute" SfxMuted="@sfxMute"
                                           Fullscreen="@settingFullscreen" Vsync="@settingVsync" 
                                           ScreenShake="@settingScreenShake" FpsCounter="@settingFps" CrtFilter="@settingCrt"
                                           OnMasterVolumeChanged="(v) => { masterVol = v; StateHasChanged(); }"
                                           OnMusicVolumeChanged="(v) => { musicVol = v; StateHasChanged(); }"
                                           OnSfxVolumeChanged="(v) => { sfxVol = v; StateHasChanged(); }"
                                           OnToggleMasterMute="() => { masterMute = !masterMute; StateHasChanged(); }"
                                           OnToggleMusicMute="() => { musicMute = !musicMute; StateHasChanged(); }"
                                           OnToggleSfxMute="() => { sfxMute = !sfxMute; StateHasChanged(); }"
                                           OnToggleFullscreen="() => { settingFullscreen = !settingFullscreen; StateHasChanged(); }"
                                           OnToggleVsync="() => { settingVsync = !settingVsync; StateHasChanged(); }"
                                           OnToggleScreenShake="() => { settingScreenShake = !settingScreenShake; StateHasChanged(); }"
                                           OnToggleFpsCounter="() => { settingFps = !settingFps; StateHasChanged(); }"
                                           OnToggleCrtFilter="() => { settingCrt = !settingCrt; StateHasChanged(); }" />
                        break;
                    case "hud-overlay":
                        <HudOverlayPreview HudHealth="@hudHealth" Score="@hudScore" Stamina="@hudStamina" 
                                           CurrentAmmo="@hudCurrentAmmo" ReserveAmmo="@hudReserveAmmo"
                                           IsTakingDamage="@hudFlash" />
                        break;

                    /* MOVEMENT */
                    case "platformer-2d":
                        <PlatformerPreview @ref="platformerRef" />
                        break;
                    case "topdown-2d":
                        <TopDownPreview @ref="topdownRef" />
                        break;
                    case "fighting-2d":
                        <FightingPreview @ref="fighterRef" />
                        break;
                    case "fps-3d":
                        <FpsPreview @ref="fpsRef" />
                        break;
                    case "thirdperson-3d":
                        <ThirdPersonPreview @ref="tpRef" />
                        break;

                    /* COMBAT */
                    case "hitscan":
                        <HitscanPreview @ref="hitscanRef" />
                        break;
                    case "projectile":
                        <ProjectilePreview @ref="projectileRef" />
                        break;
                    case "melee-hitbox":
                        <MeleePreview @ref="meleeRef" />
                        break;

                    /* SYSTEMS */
                    case "grid-inventory":
                        <InventoryPreview @ref="inventoryRef" />
                        break;
                    case "interact-prompt":
                        <InteractablePreview @ref="interactRef" />
                        break;
                    case "day-night":
                        <DayNightPreview @ref="dayNightRef" />
                        break;
                }
            </div>
        </main>

        <!-- 3. RIGHT INSPECTOR -->
        <aside class="bg-terminal-1 border border-line rounded-[14px] shadow-[inset_0_1px_0_rgba(255,255,255,0.025),0_14px_36px_rgba(0,0,0,0.35)] flex flex-col overflow-y-auto">
            <div class="sticky top-0 z-10 h-[42px] flex items-center justify-between px-4 text-[10.5px] font-semibold tracking-widest bg-terminal-1/90 backdrop-blur border-b border-line text-accent">
                <span>INSPECTOR</span>
                <span class="text-[#6a7e73] font-normal">— Dynamic Controls</span>
            </div>

            <!-- Dynamic Component Inspector Controls -->
            <div class="p-4 border-b border-line flex flex-col gap-2">
                @switch (selectedComponent.Id)
                {
                    case "linear-bar":
                        <div class="text-[10px] tracking-wider text-[#6a7e73] font-semibold uppercase mb-1">Health Controls</div>
                        <div class="flex gap-2">
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-red-500/20 to-red-500/10 text-[#ffa3a3] border border-red-500/40 hover:border-red-400 active:scale-95 transition-all" 
                                    @onclick="() => TriggerHealthDelta(-20)">− DAMAGE 20</button>
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-accent/20 to-accent/10 text-[#86ffbf] border border-accent/40 hover:border-accent active:scale-95 transition-all" 
                                    @onclick="() => TriggerHealthDelta(10)">+ HEAL 10</button>
                        </div>
                        <div class="mt-2">
                            <div class="flex justify-between items-center text-[11px] text-[#9db0a5] mb-1">
                                <span>Current HP</span>
                                <span class="bg-accent-bg border border-accent-line text-accent px-2 py-0.5 rounded text-[11px] font-semibold">@targetHealth</span>
                            </div>
                            <input type="range" min="0" max="100" value="@targetHealth" @oninput="OnSliderInput" class="w-full accent-accent cursor-pointer" />
                        </div>
                        <div @onclick="() => enableGhost = !enableGhost" class="flex items-center gap-2 cursor-pointer mt-1 text-xs text-[#9db0a5] hover:text-white transition-colors">
                            <div class="w-4 h-4 rounded border flex items-center justify-center transition-colors @(enableGhost ? "bg-accent-bg border-accent text-accent" : "border-line-3 bg-terminal-2")">
                                @if (enableGhost) { <span class="text-[10px] font-bold">✓</span> }
                            </div>
                            <span>Ghost Bar Effect</span>
                        </div>
                        break;

                    case "heart-system":
                        <div class="text-[10px] tracking-wider text-[#6a7e73] font-semibold uppercase mb-1">Heart System</div>
                        <div class="flex gap-2">
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-red-500/20 to-red-500/10 text-[#ffa3a3] border border-red-500/40 hover:border-red-400 active:scale-95 transition-all"
                                    @onclick="() => heartPoints = Math.Max(0, heartPoints - 1)">− DAMAGE</button>
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-accent/20 to-accent/10 text-[#86ffbf] border border-accent/40 hover:border-accent active:scale-95 transition-all"
                                    @onclick="() => heartPoints = Math.Min(maxHearts * 2, heartPoints + 1)">+ HEAL</button>
                        </div>
                        <div class="text-[10px] tracking-wider text-[#6a7e73] font-semibold uppercase mt-3 mb-1">Container Size (5–30)</div>
                        <div class="flex gap-2">
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 hover:border-line-3 hover:text-white active:scale-95 transition-all"
                                    @onclick="DecreaseMaxHearts">− MAX HEART</button>
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 hover:border-line-3 hover:text-white active:scale-95 transition-all"
                                    @onclick="IncreaseMaxHearts">+ MAX HEART</button>
                        </div>
                        <button class="w-full h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 hover:border-line-3 hover:text-white active:scale-95 transition-all mt-1"
                                @onclick="ResetHearts">RESET</button>
                        break;

                    case "overhead-bar":
                        <div class="text-[10px] tracking-wider text-[#6a7e73] font-semibold uppercase mb-1">Floating Bar</div>
                        <div class="flex gap-2">
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-red-500/20 to-red-500/10 text-[#ffa3a3] border border-red-500/40 hover:border-red-400 active:scale-95 transition-all"
                                    @onclick="() => overheadHealth = Math.Max(0, overheadHealth - 15)">− DAMAGE 15</button>
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-accent/20 to-accent/10 text-[#86ffbf] border border-accent/40 hover:border-accent active:scale-95 transition-all"
                                    @onclick="() => overheadHealth = Math.Min(100, overheadHealth + 10)">+ HEAL 10</button>
                        </div>
                        <button class="w-full h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 hover:border-line-3 hover:text-white active:scale-95 transition-all mt-1"
                                @onclick="() => overheadHealth = 100">RESET</button>
                        break;

                    case "shield-layer":
                        <div class="text-[10px] tracking-wider text-[#6a7e73] font-semibold uppercase mb-1">Shield & Armor</div>
                        <div class="flex gap-2">
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-red-500/20 to-red-500/10 text-[#ffa3a3] border border-red-500/40 hover:border-red-400 active:scale-95 transition-all"
                                    @onclick="DamageShield">− HIT</button>
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-accent/20 to-accent/10 text-[#86ffbf] border border-accent/40 hover:border-accent active:scale-95 transition-all"
                                    @onclick="HealShieldHealth">+ HEAL</button>
                        </div>
                        <button class="w-full h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 hover:border-line-3 hover:text-white active:scale-95 transition-all mt-1"
                                @onclick="ResetShield">RESET</button>
                        break;

                    case "main-menu":
                        <div class="text-[10px] tracking-wider text-[#6a7e73] font-semibold uppercase mb-1">Main Menu Actions</div>
                        @foreach (var opt in new[] { "NEW GAME", "LOAD GAME", "SETTINGS", "QUIT" })
                        {
                            <button class="w-full h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 hover:border-line-3 hover:text-white active:scale-95 transition-all"
                                    @onclick="() => TriggerMenuAction(opt)">@opt</button>
                        }
                        <span class="text-[10px] text-[#6a7e73] mt-1">Keyboard: [W / S] Navigate · [ENTER] Select</span>
                        break;

                    case "pause-menu":
                        <div class="text-[10px] tracking-wider text-[#6a7e73] font-semibold uppercase mb-1">Pause State</div>
                        <button class="w-full h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-amber-500/20 to-amber-500/10 text-[#ffd47d] border border-amber-500/40 hover:border-amber-400 active:scale-95 transition-all"
                                @onclick="() => isGamePaused = !isGamePaused">TOGGLE PAUSE (ESC)</button>
                        <div class="flex gap-2 mt-1">
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-accent/20 to-accent/10 text-[#86ffbf] border border-accent/40 active:scale-95 transition-all"
                                    @onclick="() => isGamePaused = false">RESUME</button>
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-red-500/20 to-red-500/10 text-[#ffa3a3] border border-red-500/40 active:scale-95 transition-all"
                                    @onclick="() => isGamePaused = false">QUIT</button>
                        </div>
                        break;

                    case "audio-settings":
                        <div class="text-[10px] tracking-wider text-[#6a7e73] font-semibold uppercase mb-1">Audio Sliders</div>
                        <div class="flex flex-col gap-2">
                            <div>
                                <div class="flex justify-between text-[11px] text-[#9db0a5]"><span>Master</span><span>@((int)(masterVol * 100))%</span></div>
                                <input type="range" min="0" max="1" step="0.01" value="@masterVol" @oninput="e => masterVol = Convert.ToSingle(e.Value)" class="w-full accent-accent" />
                            </div>
                            <div>
                                <div class="flex justify-between text-[11px] text-[#9db0a5]"><span>SFX</span><span>@((int)(sfxVol * 100))%</span></div>
                                <input type="range" min="0" max="1" step="0.01" value="@sfxVol" @oninput="e => sfxVol = Convert.ToSingle(e.Value)" class="w-full accent-accent" />
                            </div>
                            <div>
                                <div class="flex justify-between text-[11px] text-[#9db0a5]"><span>Music</span><span>@((int)(musicVol * 100))%</span></div>
                                <input type="range" min="0" max="1" step="0.01" value="@musicVol" @oninput="e => musicVol = Convert.ToSingle(e.Value)" class="w-full accent-accent" />
                            </div>
                        </div>
                        break;

                    case "hud-overlay":
                        <div class="text-[10px] tracking-wider text-[#6a7e73] font-semibold uppercase mb-1">HUD Triggers</div>
                        <button class="w-full h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-red-500/20 to-red-500/10 text-[#ffa3a3] border border-red-500/40 active:scale-95 transition-all"
                                @onclick="TakeHudHit">HIT PLAYER (-20 HP)</button>
                        <div class="flex gap-2">
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-amber-500/20 to-amber-500/10 text-[#ffd47d] border border-amber-500/40 active:scale-95 transition-all"
                                    @onclick="FireWeapon">FIRE WEAPON</button>
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-blue-500/20 to-blue-500/10 text-[#92d4ff] border border-blue-500/40 active:scale-95 transition-all"
                                    @onclick="ConsumeHudStamina">DASH (-25 STAMINA)</button>
                        </div>
                        <div class="flex gap-2">
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-accent/20 to-accent/10 text-[#86ffbf] border border-accent/40 active:scale-95 transition-all"
                                    @onclick="() => hudScore += 1500">+1500 SCORE</button>
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 active:scale-95 transition-all"
                                    @onclick="ResetHud">RESET</button>
                        </div>
                        break;

                    case "platformer-2d":
                        <div class="text-[10px] tracking-wider text-[#6a7e73] font-semibold uppercase mb-1">2D Platformer</div>
                        <div class="flex gap-2">
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 active:scale-95 transition-all"
                                    @onmousedown="() => platformerRef?.MoveLeft(true)" @onmouseup="() => platformerRef?.MoveLeft(false)">◄</button>
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-accent/20 to-accent/10 text-[#86ffbf] border border-accent/40 active:scale-95 transition-all"
                                    @onclick="() => platformerRef?.TriggerJump()">JUMP ▲</button>
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 active:scale-95 transition-all"
                                    @onmousedown="() => platformerRef?.MoveRight(true)" @onmouseup="() => platformerRef?.MoveRight(false)">►</button>
                        </div>
                        <button class="w-full h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 active:scale-95 transition-all mt-1"
                                @onclick="() => platformerRef?.Reset()">RESET</button>
                        break;

                    case "topdown-2d":
                        <div class="text-[10px] tracking-wider text-[#6a7e73] font-semibold uppercase mb-1">2D Top-Down</div>
                        <button class="w-full h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 active:scale-95 transition-all"
                                @onmousedown="() => topdownRef?.MoveUp(true)" @onmouseup="() => topdownRef?.MoveUp(false)">▲ UP</button>
                        <div class="flex gap-2 my-1">
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 active:scale-95 transition-all"
                                    @onmousedown="() => topdownRef?.MoveLeft(true)" @onmouseup="() => topdownRef?.MoveLeft(false)">◄ LEFT</button>
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 active:scale-95 transition-all"
                                    @onmousedown="() => topdownRef?.MoveRight(true)" @onmouseup="() => topdownRef?.MoveRight(false)">► RIGHT</button>
                        </div>
                        <button class="w-full h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 active:scale-95 transition-all"
                                @onmousedown="() => topdownRef?.MoveDown(true)" @onmouseup="() => topdownRef?.MoveDown(false)">▼ DOWN</button>
                        <button class="w-full h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 active:scale-95 transition-all mt-1"
                                @onclick="() => topdownRef?.Reset()">RESET</button>
                        break;

                    case "fighting-2d":
                        <div class="text-[10px] tracking-wider text-[#6a7e73] font-semibold uppercase mb-1">Footsies Controller</div>
                        <div class="flex gap-2">
                            <button class="flex-1 h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 active:scale-95 transition-all"
