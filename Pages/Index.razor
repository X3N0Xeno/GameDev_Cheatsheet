                                @onclick="() => inventoryRef?.ClearAll()">CLEAR ALL</button>
                        break;

                    case "interact-prompt":
                        <div class="text-[10px] tracking-wider text-[#6a7e73] font-semibold uppercase mb-1">Interactable Object</div>
