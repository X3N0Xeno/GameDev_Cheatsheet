@page "/sandbox"
@implements IDisposable

<div class="flex flex-col min-h-screen bg-terminal-0 text-[#d6e1da] font-mono select-none">
    <!-- TOP STATUS & ROUTE BAR -->
    <header class="flex-none h-[46px] flex items-center justify-between px-5 text-xs bg-gradient-to-b from-white/[0.025] to-transparent border-b border-line">
        <div class="flex items-center gap-3 min-w-0">
            <div class="flex items-center gap-2 mr-3 opacity-80">
                <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f57] inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#febc2e] inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#28c840] inline-block"></span>
            </div>
            <span class="text-accent font-semibold tracking-wide whitespace-nowrap pl-3 border-l border-line-2 leading-5">
                GameDev Cheatsheet
            </span>
            <span class="text-[#6a7e73] whitespace-nowrap overflow-hidden text-ellipsis">
                — Physics & Kinematics Sandbox
            </span>
        </div>

        <nav class="flex items-center gap-2 text-[11px]">
            <a href="/" class="px-3 py-1 rounded-md text-[#9db0a5] hover:text-white hover:bg-white/5 border border-transparent transition-colors">
                [CHEATSHEET]
            </a>
            <a href="/architecture" class="px-3 py-1 rounded-md text-[#9db0a5] hover:text-white hover:bg-white/5 border border-transparent transition-colors">
                [ARCHITECTURE]
            </a>
            <a href="/sandbox" class="px-3 py-1 rounded-md bg-accent-bg text-accent border border-accent-line font-semibold transition-colors">
                [SANDBOX]
            </a>
        </nav>
    </header>

    <!-- MAIN SANDBOX VIEW -->
    <main class="flex-1 p-4 grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-4 max-w-7xl mx-auto w-full">
        <!-- SANDBOX CANVAS STAGE -->
        <div class="relative bg-terminal-1 border border-line rounded-xl flex flex-col overflow-hidden min-h-[460px]">
            <div class="h-[38px] px-4 flex items-center justify-between border-b border-line text-xs font-semibold text-accent">
                <span>SIMULATION STAGE</span>
                <span class="text-[#6a7e73] font-normal">CLICK ANYWHERE TO SPAWN BALL</span>
            </div>

            <div class="relative flex-1 bg-[#060907] cursor-crosshair overflow-hidden" @onmousedown="SpawnBall">
                <svg width="100%" height="100%" viewBox="0 0 800 440" class="absolute inset-0">
                    <defs>
                        <pattern id="sandboxGrid" width="32" height="32" patternUnits="userSpaceOnUse">
                            <path d="M 32 0 L 0 0 0 32" fill="none" stroke="#0e150e" stroke-width="0.8" />
                        </pattern>
                    </defs>
                    <rect width="800" height="440" fill="url(#sandboxGrid)" />

                    <!-- Floor & Walls -->
                    <line x1="0" y1="410" x2="800" y2="410" stroke="#2a4a2a" stroke-width="2" />

                    <!-- Bouncer Obstacles -->
                    <rect x="220" y="260" width="100" height="16" fill="#152618" stroke="#3a6a3a" rx="4" />
                    <rect x="480" y="200" width="120" height="16" fill="#152618" stroke="#3a6a3a" rx="4" />

                    <!-- Live Physics Particles -->
                    @foreach (var b in balls)
                    {
                        <circle cx="@b.X" cy="@b.Y" r="@b.Radius" fill="#4ade80" stroke="#86ffbf" stroke-width="1.5" />
                        <line x1="@b.X" y1="@b.Y" x2="@(b.X + b.Vx * 0.05)" y2="@(b.Y + b.Vy * 0.05)" stroke="rgba(255,203,107,0.7)" stroke-width="1.5" />
                    }
                </svg>

                <div class="absolute bottom-3 left-4 text-[10.5px] text-[#5a7a58]">
                    BODIES: @balls.Count | GRAVITY: @((int)gravity) px/s² | RESTITUTION: @restitution.ToString("0.00")
                </div>
            </div>
        </div>

        <!-- CONTROL PANEL -->
        <aside class="bg-terminal-1 border border-line rounded-xl p-4 flex flex-col gap-4 text-xs">
            <div class="border-b border-line pb-2 font-semibold text-accent tracking-wider uppercase text-[11px]">
                Physics Parameters
            </div>

            <div>
                <div class="flex justify-between text-[11px] mb-1">
                    <span class="text-[#9db0a5]">Gravity (px/s²)</span>
                    <span class="text-accent font-semibold">@((int)gravity)</span>
                </div>
                <input type="range" min="0" max="2500" step="50" @bind="gravity" @bind:event="oninput" class="w-full accent-accent cursor-pointer" />
            </div>

            <div>
                <div class="flex justify-between text-[11px] mb-1">
                    <span class="text-[#9db0a5]">Restitution (Bounciness)</span>
                    <span class="text-accent font-semibold">@restitution.ToString("0.00")</span>
                </div>
                <input type="range" min="0.1" max="0.95" step="0.05" @bind="restitution" @bind:event="oninput" class="w-full accent-accent cursor-pointer" />
            </div>

            <div>
                <div class="flex justify-between text-[11px] mb-1">
                    <span class="text-[#9db0a5]">Friction Dampening</span>
                    <span class="text-accent font-semibold">@friction.ToString("0.00")</span>
                </div>
                <input type="range" min="0.80" max="0.99" step="0.01" @bind="friction" @bind:event="oninput" class="w-full accent-accent cursor-pointer" />
            </div>

            <div class="pt-2 border-t border-line flex flex-col gap-2">
                <button class="h-[34px] px-3 font-semibold text-xs rounded-md bg-gradient-to-b from-accent/20 to-accent/10 text-[#86ffbf] border border-accent/40 active:scale-95 transition-all"
                        @onclick="BurstSpawn">
                    BURST SPAWN (x5)
                </button>
                <button class="h-[34px] px-3 font-semibold text-xs rounded-md bg-terminal-3 text-[#9db0a5] border border-line-2 hover:border-line-3 hover:text-white active:scale-95 transition-all"
                        @onclick="() => balls.Clear()">
                    CLEAR ALL BODIES
                </button>
            </div>
        </aside>
    </main>
</div>

@code {
    public class Ball { public double X; public double Y; public double Vx; public double Vy; public double Radius = 9; }
    private readonly List<Ball> balls = new();

    private double gravity = 980;
    private double restitution = 0.70;
    private double friction = 0.96;

    private CancellationTokenSource cts = new();

    protected override void OnInitialized()
    {
        _ = RunSandboxPhysicsAsync(cts.Token);
    }

    private async Task RunSandboxPhysicsAsync(CancellationToken token)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromMilliseconds(16));
        DateTime last = DateTime.UtcNow;

        while (!token.IsCancellationRequested && await timer.WaitForNextTickAsync(token))
        {
            DateTime now = DateTime.UtcNow;
            double dt = Math.Min((now - last).TotalSeconds, 0.05);
            last = now;

            for (int i = balls.Count - 1; i >= 0; i--)
            {
                var b = balls[i];
                b.Vy += gravity * dt;
                b.X += b.Vx * dt;
                b.Y += b.Vy * dt;

                // Floor bounce
                if (b.Y >= 410 - b.Radius)
                {
                    b.Y = 410 - b.Radius;
                    b.Vy = -b.Vy * restitution;
                    b.Vx *= friction;
                }

                // Walls
                if (b.X <= b.Radius) { b.X = b.Radius; b.Vx = -b.Vx * restitution; }
                if (b.X >= 800 - b.Radius) { b.X = 800 - b.Radius; b.Vx = -b.Vx * restitution; }

                // Obstacle 1 (220 to 320, Y=260)
                if (b.X >= 215 && b.X <= 325 && b.Y >= 250 && b.Y <= 276 && b.Vy > 0)
                {
                    b.Y = 250;
                    b.Vy = -b.Vy * restitution;
                }

                // Obstacle 2 (480 to 600, Y=200)
                if (b.X >= 475 && b.X <= 605 && b.Y >= 190 && b.Y <= 216 && b.Vy > 0)
                {
                    b.Y = 190;
                    b.Vy = -b.Vy * restitution;
                }
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private void SpawnBall(MouseEventArgs e)
    {
        balls.Add(new Ball
        {
            X = Math.Clamp(e.OffsetX, 20, 780),
            Y = Math.Clamp(e.OffsetY, 20, 380),
            Vx = Random.Shared.Next(-200, 200),
            Vy = Random.Shared.Next(-100, 50)
        });
    }

    private void BurstSpawn()
    {
        for (int i = 0; i < 5; i++)
        {
            balls.Add(new Ball
            {
                X = 400 + Random.Shared.Next(-80, 80),
                Y = 60 + Random.Shared.Next(-20, 20),
                Vx = Random.Shared.Next(-300, 300),
                Vy = Random.Shared.Next(-150, 0)
            });
        }
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }
}