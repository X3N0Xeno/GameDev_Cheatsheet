@page "/sandbox"
@namespace GameDevCheatsheet.Pages

<div class="flex flex-col min-h-screen bg-terminal-0 text-[#d6e1da] font-mono select-none outline-none"
     tabindex="0"
     @onkeydown="HandleKeyDown"
     @onkeyup="HandleKeyUp"
     autofocus>

    <!-- TOP STATUS & ROUTE BAR -->
    <header class="flex-none h-[46px] flex items-center justify-between px-5 text-xs bg-gradient-to-b from-white/[0.025] to-transparent border-b border-line">
        <div class="flex items-center gap-3 min-w-0">
            <div class="flex items-center gap-2 mr-3 opacity-80">
                <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f57] inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#febc2e] inline-block"></span>
                <span class="w-2.5 h-2.5 rounded-full bg-[#28c840] inline-block"></span>
            </div>
            <span class="text-accent font-semibold tracking-wide whitespace-nowrap pl-3 border-l border-line-2 leading-5">
                GameDev Cheatsheet
            </span>
            <span class="text-[#6a7e73] whitespace-nowrap overflow-hidden text-ellipsis">
                — Interactive Demo Game & Sandbox Level Designer
            </span>
        </div>

        <nav class="flex items-center gap-2 text-[11px]">
            <a href="/" class="px-3 py-1 rounded-md text-[#9db0a5] hover:text-white hover:bg-white/5 border border-transparent transition-colors">
                [CHEATSHEET]
            </a>
            <a href="/architecture" class="px-3 py-1 rounded-md text-[#9db0a5] hover:text-white hover:bg-white/5 border border-transparent transition-colors">
                [ARCHITECTURE]
            </a>
            <a href="/sandbox" class="px-3 py-1 rounded-md bg-accent-bg text-accent border border-accent-line font-semibold transition-colors">
                [SANDBOX]
            </a>
        </nav>
    </header>

    <!-- MAIN SANDBOX VIEW -->
    <main class="flex-1 p-3.5 grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-3 max-w-7xl mx-auto w-full">
        <!-- SANDBOX CANVAS STAGE -->
        <div class="relative bg-terminal-1 border border-line rounded-xl flex flex-col overflow-hidden min-h-[500px]">
            <!-- Canvas Toolbar -->
            <div class="h-[44px] px-4 flex items-center justify-between border-b border-line bg-terminal-1/90 backdrop-blur text-xs">
                <!-- Mode & Tool Selector -->
                <div class="flex items-center gap-2">
                    <span class="text-accent font-semibold mr-1">TOOL:</span>
                    <button class="px-2.5 py-1 rounded text-[11px] font-semibold border transition-all @(currentTool == ToolMode.Platform ? "bg-accent-bg border-accent text-accent" : "border-line-2 text-[#9db0a5] hover:text-white")"
                            @onclick="() => currentTool = ToolMode.Platform">
                        [+] PLATFORM
                    </button>
                    <button class="px-2.5 py-1 rounded text-[11px] font-semibold border transition-all @(currentTool == ToolMode.Hazard ? "bg-red-500/20 border-red-500 text-red-300" : "border-line-2 text-[#9db0a5] hover:text-white")"
                            @onclick="() => currentTool = ToolMode.Hazard">
                        [!] SPIKE
                    </button>
                    <button class="px-2.5 py-1 rounded text-[11px] font-semibold border transition-all @(currentTool == ToolMode.Coin ? "bg-amber-500/20 border-amber-500 text-amber-300" : "border-line-2 text-[#9db0a5] hover:text-white")"
                            @onclick="() => currentTool = ToolMode.Coin">
                        [★] COIN
                    </button>
                    <button class="px-2.5 py-1 rounded text-[11px] font-semibold border transition-all @(currentTool == ToolMode.Erase ? "bg-white/10 border-white text-white" : "border-line-2 text-[#9db0a5] hover:text-white")"
                            @onclick="() => currentTool = ToolMode.Erase">
                        [✕] ERASE
                    </button>
                </div>

                <!-- Map Actions -->
                <div class="flex items-center gap-2 text-[11px]">
                    <button class="px-2 py-0.5 rounded border border-line-2 hover:border-line-3 text-[#9db0a5] hover:text-white"
                            @onclick="LoadDefaultLayout">
                        DEFAULT MAP
                    </button>
                    <button class="px-2 py-0.5 rounded border border-line-2 hover:border-line-3 text-[#9db0a5] hover:text-white"
                            @onclick="ClearMap">
                        CLEAR
                    </button>
                    <button class="px-2 py-0.5 rounded bg-accent-bg border border-accent-line text-accent font-semibold"
                            @onclick="RespawnPlayer">
                        RESET PLAYER
                    </button>
                </div>
            </div>

            <!-- Interactive Viewport Stage -->
            <div class="relative flex-1 bg-[#060907] overflow-hidden cursor-crosshair select-none">
                <svg id="sandboxSvgCanvas"
                    width="100%" 
                    height="100%" 
                    viewBox="0 0 860 480" 
                    preserveAspectRatio="none"
                    class="absolute inset-0 w-full h-full"
                    @onmousedown="HandleCanvasClick">
                    <defs>
                        <pattern id="sandboxMapGrid" width="40" height="40" patternUnits="userSpaceOnUse">
                            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#0e150e" stroke-width="0.8" />
                        </pattern>
                    </defs>
                    <rect width="860" height="480" fill="url(#sandboxMapGrid)" pointer-events="all" />

                    <!-- Fixed Boundary Floor -->
                    <line x1="0" y1="460" x2="860" y2="460" stroke="#2a4a2a" stroke-width="2.5" pointer-events="none" />

                    <!-- Custom Drawn Platforms -->
                    @foreach (var p in platforms)
                    {
                        <g pointer-events="none">
                            <rect x="@p.X" y="@p.Y" width="@p.W" height="@p.H" fill="#142417" stroke="#366b3b" stroke-width="1.5" rx="3" />
                            <line x1="@p.X" y1="@p.Y" x2="@(p.X + p.W)" y2="@p.Y" stroke="#4ade80" stroke-width="2.5" />
                        </g>
                    }

                    <!-- Hazards / Spikes -->
                    @foreach (var h in hazards)
                    {
                        <polygon points="@(h.X),@(h.Y + 20) @(h.X + 15),@(h.Y) @(h.X + 30),@(h.Y + 20)" 
                                 fill="rgba(255, 68, 68, 0.4)" stroke="#ff4444" stroke-width="1.5" pointer-events="none" />
                    }

                    <!-- Collectible Coins -->
                    @foreach (var c in coins)
                    {
                        <circle cx="@c.X" cy="@c.Y" r="8" fill="#ffd07a" stroke="#ffa500" stroke-width="1.5" pointer-events="none">
                            <animate attributeName="r" values="8;9.5;8" dur="1.2s" repeatCount="indefinite" />
                        </circle>
                    }

                    <!-- Playable Character Body -->
                    @{
                        double eyeX = playerFacing > 0 ? (playerX + 3) : (playerX - 7);
                    }
                    <g pointer-events="none">
                        <rect x="@(playerX - 10)" y="@(playerY - 26)" width="20" height="28" fill="#090f0a" rx="2" />
                        <rect x="@(playerX - 8)" y="@(playerY - 24)" width="16" height="24" 
                              fill="@(playerFlash ? "#ff4444" : "#4ade80")" stroke="#86ffbf" stroke-width="1.2" rx="2" />
                        <rect x="@eyeX" y="@(playerY - 18)" width="4" height="4" fill="#090f0a" />
                        <text x="@playerX" y="@(playerY - 32)" fill="#86ffbf" font-family="'JetBrains Mono', monospace" font-size="9" text-anchor="middle">
                            @(onFloor ? (playerVx != 0 ? "RUN" : "IDLE") : (playerVy < 0 ? "JUMP" : "FALL"))
                        </text>
                    </g>
                </svg>

                <!-- In-Game HUD Overlay -->
                <div class="absolute top-3 left-4 flex gap-4 text-xs font-semibold bg-terminal-0/80 backdrop-blur px-3 py-1.5 rounded border border-line-2 pointer-events-none">
                    <span class="text-accent">SCORE: @score</span>
                    <span class="text-red-400">DEATHS: @deaths</span>
                    <span class="text-amber-300">COINS REMAINING: @coins.Count</span>
                </div>

                <!-- Navigation Controls Help Tag -->
                <div class="absolute bottom-3 left-4 text-[10.5px] text-[#5a7a58] pointer-events-none">
                    CONTROLS: [A / D] WALK · [SPACE] JUMP · CLICK CANVAS TO USE SELECTED EDIT TOOL
                </div>
            </div>
        </div>

        <!-- GODOT LIVE INSPECTOR PANEL -->
        <aside class="bg-terminal-1 border border-line rounded-xl p-4 flex flex-col gap-4 text-xs overflow-y-auto">
            <div class="border-b border-line pb-2 flex justify-between items-center">
                <span class="font-semibold text-accent tracking-wider uppercase text-[11px]">Godot 4 Player Variables</span>
                <span class="text-[10px] text-[#6a7e73]">CharacterBody2D</span>
            </div>

            <!-- Sliders -->
            <div class="space-y-3.5">
                <div>
                    <div class="flex justify-between text-[11px] mb-1">
                        <span class="text-[#9db0a5]">Move Speed (px/s)</span>
                        <span class="text-accent font-semibold">@((int)speed)</span>
                    </div>
                    <input type="range" min="100" max="500" step="10" @bind="speed" @bind:event="oninput" class="w-full accent-accent cursor-pointer" />
                </div>

                <div>
                    <div class="flex justify-between text-[11px] mb-1">
                        <span class="text-[#9db0a5]">Jump Velocity</span>
                        <span class="text-accent font-semibold">@((int)jumpVelocity)</span>
                    </div>
                    <input type="range" min="200" max="750" step="10" @bind="jumpVelocity" @bind:event="oninput" class="w-full accent-accent cursor-pointer" />
                </div>

                <div>
                    <div class="flex justify-between text-[11px] mb-1">
                        <span class="text-[#9db0a5]">Gravity Scale</span>
                        <span class="text-accent font-semibold">@((int)gravity)</span>
                    </div>
                    <input type="range" min="300" max="2200" step="50" @bind="gravity" @bind:event="oninput" class="w-full accent-accent cursor-pointer" />
                </div>

                <div>
                    <div class="flex justify-between text-[11px] mb-1">
                        <span class="text-[#9db0a5]">Acceleration Lerp</span>
                        <span class="text-accent font-semibold">@((int)acceleration)</span>
                    </div>
                    <input type="range" min="400" max="3000" step="100" @bind="acceleration" @bind:event="oninput" class="w-full accent-accent cursor-pointer" />
                </div>

                <div>
                    <div class="flex justify-between text-[11px] mb-1">
                        <span class="text-[#9db0a5]">Friction Decel</span>
                        <span class="text-accent font-semibold">@((int)friction)</span>
                    </div>
                    <input type="range" min="400" max="3000" step="100" @bind="friction" @bind:event="oninput" class="w-full accent-accent cursor-pointer" />
                </div>
            </div>

            <!-- Godot Script Live Export -->
            <div class="border-t border-line pt-3 flex flex-col flex-1">
                <div class="flex justify-between items-center mb-1.5">
                    <span class="text-[10px] text-[#6a7e73] font-semibold tracking-wider uppercase">EXPORTED GODOT SCRIPT</span>
                    <button class="text-[10px] text-accent hover:underline font-semibold" @onclick="CopyGodotScript">
                        [COPY CODE]
                    </button>
                </div>
                <div class="bg-terminal-0 border border-line-2 rounded p-2.5 text-[10px] text-[#8ecbff] font-mono overflow-auto flex-1 max-h-[160px] select-text">
                    <pre><code>extends CharacterBody2D

const SPEED = @speed.ToString("0.0")
const JUMP_VELOCITY = -@jumpVelocity.ToString("0.0")
const ACCELERATION = @acceleration.ToString("0.0")
const FRICTION = @friction.ToString("0.0")

var gravity = @gravity.ToString("0.0")

func _physics_process(delta: float) -> void:
    if not is_on_floor():
        velocity.y += gravity * delta

    if Input.is_action_just_pressed("ui_accept") and is_on_floor():
        velocity.y = JUMP_VELOCITY

    var direction := Input.get_axis("ui_left", "ui_right")
    if direction:
        velocity.x = move_toward(velocity.x, direction * SPEED, ACCELERATION * delta)
    else:
        velocity.x = move_toward(velocity.x, 0, FRICTION * delta)

    move_and_slide()</code></pre>
                </div>
            </div>
        </aside>
    </main>
</div>